GregRoam_Reward::
	goto_if_set FLAG_GREG_WAWA_REWARDED, GregRoam_RewardDone
	giveitem ITEM_POTION
	goto_if_eq VAR_RESULT, FALSE, GregRoam_RewardFull
	setflag FLAG_GREG_WAWA_REWARDED
	msgbox GregRoam_Text_Wawa, MSGBOX_DEFAULT
GregRoam_RewardDone::
	return
GregRoam_RewardFull::
	msgbox GregRoam_Text_Full, MSGBOX_DEFAULT
	return
GregRoam_Text_Wawa:
	.string "Greg: One tiny Wawa. Try\nnot to spend it all.$"
GregRoam_Text_Full:
	.string "Greg: Your Bag is full. My\ngenerosity can wait.$"
